<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- So pelo NotifyIcon da bandeja; o WPF nao tem equivalente nativo e
         isso evita depender de pacote de terceiros. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Yellow Vitrine</AssemblyName>
    <RootNamespace>YellowVitrine.Desktop</RootNamespace>

    <!-- Self-contained: o caixa nao precisa ter runtime .NET instalado.
         ReadyToRun compila antecipadamente o codigo mais quente, que e
         justamente o que derruba o tempo de abertura - o ponto do exercicio. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Sem trimming: o Microsoft.Data.SqlClient usa reflexao e o trim pode
         cortar coisa que so falha em runtime, na hora de conectar. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ligar o UseWindowsForms traz os global using dele, e ai Brush,
         Orientation e HorizontalAlignment passam a colidir com os equivalentes
         do WPF na tela inteira. O WinForms aqui e so o NotifyIcon da bandeja,
         entao o App.xaml.cs usa alias explicito (Forms.) e estes saem. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
