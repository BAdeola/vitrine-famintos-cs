<Window x:Class="YellowVitrine.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yellow Vitrine"
        WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- max-w-2xl centralizado, igual ao app web -->
            <StackPanel MaxWidth="672" Margin="20,32,20,24" HorizontalAlignment="Stretch">

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TituloCabecalho" Grid.Column="0" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" Text="Atualização de Vitrine"/>
                    <Button x:Name="BotaoFecharApp" Grid.Column="1" Style="{StaticResource BotaoFechar}"
                            Content="Fechar" Click="FecharApp_Click"/>
                </Grid>

                <Border x:Name="AvisoDiaFechado" Visibility="Collapsed"
                        Background="{StaticResource AmbarClaro}" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,16">
                    <TextBlock Foreground="{StaticResource AmbarTexto}" FontSize="13" TextWrapping="Wrap"
                               Text="Dia fechado — nenhuma alteração pode ser salva agora. Não há turno de caixa aberto."/>
                </Border>

                <!-- Modo homologação escreve no estoque de verdade. Deixado
                     ligado sem querer, alguém salva 100 de tudo achando que é
                     o normal — por isso o aviso é permanente e vermelho. -->
                <Border x:Name="AvisoHomologacao" Visibility="Collapsed"
                        Background="{StaticResource VermelhoClaro}" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,16">
                    <TextBlock x:Name="TextoHomologacao" Foreground="{StaticResource Vermelho}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="AvisoErro" Visibility="Collapsed"
                        Background="{StaticResource VermelhoClaro}" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,16">
                    <TextBlock x:Name="TextoErro" Foreground="{StaticResource Vermelho}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="PainelEstado" Background="{StaticResource Superficie}"
                        CornerRadius="16" Padding="20,32" Margin="0,0,0,12">
                    <TextBlock x:Name="TextoEstado" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TintaFraca}" Text="Carregando produtos…"/>
                </Border>

                <StackPanel x:Name="ListaCategorias"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Barra inferior: so aparece quando ha pendencia, igual ao app -->
        <Border x:Name="BarraSalvar" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource Superficie}" BorderBrush="#1A000000" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid MaxWidth="672" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TintaFraca}" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" Text="Você tem alterações não salvas."/>
                <Button x:Name="BotaoSalvarTudo" Grid.Column="1" Style="{StaticResource BotaoSalvar}"
                        Content="Salvar alterações" Click="Salvar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
