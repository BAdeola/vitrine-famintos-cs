<Window x:Class="YellowVitrine.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitivos="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Yellow Vitrine"
        WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Um produto: foto à esquerda, nome + quantidade à direita. A
             ALTURA é fixa (mantém todas as faixas com a mesma régua); a
             LARGURA vem da UniformGrid da faixa, que divide a linha em partes
             iguais. Encolhido para caber 4 por fileira (era 3): foto, respiro
             e margens todos menores — ver LarguraMinimaDoCard no code-behind. -->
        <DataTemplate x:Key="CardProduto">
            <Border Height="104" Margin="0,0,12,12" HorizontalAlignment="Stretch"
                    Background="{StaticResource Superficie}" CornerRadius="14"
                    BorderBrush="#14000000" BorderThickness="1">
                <Grid Margin="8,7,10,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Foto quadrada (as do repositório são 400x400). Encolhida
                         de 86 para 70 e colada mais à esquerda (margem 8) pra
                         sobrar largura à coluna da conta — sem isso o "fica"
                         cortava no caixa. -->
                    <Border Grid.Column="0" Background="#0F000000" CornerRadius="10"
                            Width="70" Height="70" VerticalAlignment="Center">
                        <Image Source="{Binding Imagem}" Stretch="Uniform" Margin="3"/>
                    </Border>

                    <!-- Nome + a conta "tinha + somar = fica", empilhados e
                         centralizados. Nome com altura fixa de duas linhas: sem
                         isso, um nome de uma linha só deixaria a conta mais alta
                         num card do que no vizinho, desalinhando a faixa. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nome}" FontSize="11" FontWeight="Bold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Height="30"/>

                        <!-- Duas linhas fixas: os rótulos (tinha/somar/final)
                             numa horizontal, os valores (texto, caixa, texto) na
                             de baixo — assim tudo alinha, em vez de pilhas de
                             alturas diferentes que desencontravam os textos.

                             "tinha" e "final" são colunas PROPORCIONAIS (as duas
                             estrelas): dividem o que sobra em partes iguais e
                             encolhem junto, então o "final" nunca transborda pra
                             fora do card. Só o "somar" (a caixa) é editável. -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Linha 0: rótulos, todos na mesma horizontal.
                                 TextWrapping deixa "Estoque Atual" e "Estoque final"
                                 quebrarem no espaço em vez de alargar a coluna — as
                                 laterais são proporcionais, então alargar uma
                                 espremeria a outra e desalinharia a faixa.
                                 "Abastecendo" é palavra única: não tem onde quebrar,
                                 e a coluna dele é Auto (colada na caixa de 44px).
                                 Se ficar apertado, o ajuste é reduzir Colunas na
                                 janela (menos cards por faixa, cada um mais largo). -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Estoque Atual" FontSize="8"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TintaFraca}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Abastecendo" FontSize="8"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{StaticResource MarcaEscura}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Estoque final" FontSize="8"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TintaFraca}"/>

                            <!-- Linha 1: valores, centralizados na mesma horizontal -->
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding QuantidadeSalva, StringFormat={}{0:0.##}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="+" FontSize="12" Margin="2,0,2,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TintaFraca}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource CampoQuantidade}"
                                     Width="44" Height="30" FontSize="13" VerticalAlignment="Center"
                                     IsEnabled="{Binding Editavel}"
                                     Text="{Binding Pendente, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="=" FontSize="12" Margin="2,0,2,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TintaFraca}"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource MarcaEscura}"
                                       Text="{Binding Total, StringFormat={}{0:0.##}}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Uma faixa horizontal de cards. A lista virtualiza POR FAIXA: o
             VirtualizingStackPanel do WPF só trabalha em uma direção, então os
             produtos são agrupados em linhas antes de entrar aqui. -->
        <DataTemplate x:Key="FaixaDeCards">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CardProduto}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Columns vem da janela, NÃO da quantidade de itens da
                             faixa: a última linha quase nunca está cheia, e sem
                             isso os cards dela ficariam esticados, mais largos
                             que os de cima. -->
                        <primitivos:UniformGrid Rows="1"
                            Columns="{Binding Colunas, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="FaixaSemSelecao" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,20,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topo: só o título e o Fechar. O estado do modo homologação e do dia
             fechado vai no próprio título (ver AtualizarTitulo), em vez de
             faixas ocupando espaço permanente. -->
        <Grid Grid.Row="0" Margin="0,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TituloCabecalho" Grid.Column="0" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       TextTrimming="CharacterEllipsis" Text="Manutenção Vitrine"/>
            <Button x:Name="BotaoFecharApp" Grid.Column="1" Style="{StaticResource BotaoFechar}"
                    Content="Fechar" Click="FecharApp_Click"/>
        </Grid>

        <!-- Erro não é texto fixo: só aparece quando algo falha, e é a única
             forma de saber que uma gravação não passou. -->
        <Border x:Name="AvisoErro" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource VermelhoClaro}" CornerRadius="12"
                Padding="16,12" Margin="0,0,12,16">
            <TextBlock x:Name="TextoErro" Foreground="{StaticResource Vermelho}"
                       FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="PainelEstado" Grid.Row="2" Background="{StaticResource Superficie}"
                CornerRadius="16" Padding="20,32" Margin="0,0,12,12">
            <TextBlock x:Name="TextoEstado" HorizontalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TintaFraca}" Text="Carregando produtos…"/>
        </Border>

        <ListBox x:Name="ListaCards" Grid.Row="3"
                 Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource FaixaDeCards}"
                 ItemContainerStyle="{StaticResource FaixaSemSelecao}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 SizeChanged="ListaCards_SizeChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Barra inferior: so aparece quando ha pendencia, igual ao app -->
        <Border x:Name="BarraSalvar" Grid.Row="4" Visibility="Collapsed"
                Background="{StaticResource Superficie}" BorderBrush="#1A000000" BorderThickness="0,1,0,0"
                Padding="20,14" Margin="-20,0,-8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TintaFraca}" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" Text="Você tem alterações não salvas."/>
                <Button x:Name="BotaoSalvarTudo" Grid.Column="1" Style="{StaticResource BotaoSalvar}"
                        Content="Salvar alterações" Click="Salvar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
