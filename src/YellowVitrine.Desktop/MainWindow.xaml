<Window x:Class="YellowVitrine.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitivos="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Yellow Vitrine"
        WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Um produto. A ALTURA é fixa (é ela que permite virtualizar); a
             LARGURA vem da UniformGrid da faixa, que divide a linha em partes
             iguais. Card de largura fixa deixava sobra à direita — quase meio
             card de espaço morto — e a grade não fechava com o título. -->
        <DataTemplate x:Key="CardProduto">
            <Border Height="290" Margin="0,0,12,12" HorizontalAlignment="Stretch"
                    Background="{StaticResource Superficie}" CornerRadius="16"
                    BorderBrush="#14000000" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- As fotos do repositório são quadradas (400x400), então
                         com Uniform quem manda no tamanho é a ALTURA desta
                         linha, não a largura do card: a 104 a foto saía com
                         92px e sobrava meia moldura vazia dos dois lados. -->
                    <Border Grid.Row="0" Background="#0F000000" CornerRadius="10"
                            Width="160" HorizontalAlignment="Center">
                        <Image Source="{Binding Imagem}" Stretch="Uniform" Margin="2"/>
                    </Border>

                    <!-- Altura fixa de duas linhas: sem ela, um nome que quebra
                         em duas linhas empurraria o campo de quantidade para
                         baixo só naquele card, desalinhando a faixa inteira. -->
                    <TextBlock Grid.Row="1" Text="{Binding Nome}" Margin="0,8,0,0"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" Height="36"
                               TextAlignment="Center"/>

                    <TextBox Grid.Row="2" Style="{StaticResource CampoQuantidade}"
                             Margin="0,6,0,0"
                             IsEnabled="{Binding Editavel}"
                             Text="{Binding Total, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"/>

                    <TextBlock Grid.Row="3" Text="{Binding TextoPendente}" Margin="0,4,0,0"
                               FontSize="11" FontWeight="SemiBold" Height="14"
                               Foreground="{StaticResource MarcaEscura}"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Uma faixa horizontal de cards. A lista virtualiza POR FAIXA: o
             VirtualizingStackPanel do WPF só trabalha em uma direção, então os
             produtos são agrupados em linhas antes de entrar aqui. -->
        <DataTemplate x:Key="FaixaDeCards">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CardProduto}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Columns vem da janela, NÃO da quantidade de itens da
                             faixa: a última linha quase nunca está cheia, e sem
                             isso os cards dela ficariam esticados, mais largos
                             que os de cima. -->
                        <primitivos:UniformGrid Rows="1"
                            Columns="{Binding Colunas, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="FaixaSemSelecao" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,20,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topo: só o título e o Fechar. O estado do modo homologação e do dia
             fechado vai no próprio título (ver AtualizarTitulo), em vez de
             faixas ocupando espaço permanente. -->
        <Grid Grid.Row="0" Margin="0,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TituloCabecalho" Grid.Column="0" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       TextTrimming="CharacterEllipsis" Text="Manutenção Vitrine"/>
            <Button x:Name="BotaoFecharApp" Grid.Column="1" Style="{StaticResource BotaoFechar}"
                    Content="Fechar" Click="FecharApp_Click"/>
        </Grid>

        <!-- Erro não é texto fixo: só aparece quando algo falha, e é a única
             forma de saber que uma gravação não passou. -->
        <Border x:Name="AvisoErro" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource VermelhoClaro}" CornerRadius="12"
                Padding="16,12" Margin="0,0,12,16">
            <TextBlock x:Name="TextoErro" Foreground="{StaticResource Vermelho}"
                       FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="PainelEstado" Grid.Row="2" Background="{StaticResource Superficie}"
                CornerRadius="16" Padding="20,32" Margin="0,0,12,12">
            <TextBlock x:Name="TextoEstado" HorizontalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource TintaFraca}" Text="Carregando produtos…"/>
        </Border>

        <ListBox x:Name="ListaCards" Grid.Row="3"
                 Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource FaixaDeCards}"
                 ItemContainerStyle="{StaticResource FaixaSemSelecao}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 SizeChanged="ListaCards_SizeChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Barra inferior: so aparece quando ha pendencia, igual ao app -->
        <Border x:Name="BarraSalvar" Grid.Row="4" Visibility="Collapsed"
                Background="{StaticResource Superficie}" BorderBrush="#1A000000" BorderThickness="0,1,0,0"
                Padding="20,14" Margin="-20,0,-8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TintaFraca}" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" Text="Você tem alterações não salvas."/>
                <Button x:Name="BotaoSalvarTudo" Grid.Column="1" Style="{StaticResource BotaoSalvar}"
                        Content="Salvar alterações" Click="Salvar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
