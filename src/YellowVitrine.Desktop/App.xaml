<Application x:Class="YellowVitrine.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YellowVitrine.Desktop">
    <Application.Resources>

        <!-- Mesmas cores do tema do app Electron (src/index.css, bloco @theme) -->
        <SolidColorBrush x:Key="Marca" Color="#F9D600"/>
        <SolidColorBrush x:Key="MarcaEscura" Color="#E0C000"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="Superficie" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Tinta" Color="#000000"/>
        <SolidColorBrush x:Key="TintaFraca" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="Vermelho" Color="#DC2626"/>
        <SolidColorBrush x:Key="VermelhoClaro" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="VermelhoBorda" Color="#FECACA"/>
        <SolidColorBrush x:Key="AmbarClaro" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="AmbarTexto" Color="#92400E"/>

        <!-- Poppins e a fonte do app web; cai em Segoe UI se nao estiver instalada -->
        <FontFamily x:Key="Fonte">Poppins, Segoe UI</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Fonte}"/>
            <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
        </Style>

        <!-- Botao redondo do +/-: amarelo, 36px, com o estado desabilitado a 40% -->
        <Style x:Key="BotaoRedondo" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource Fonte}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{StaticResource Marca}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource MarcaEscura}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoSalvar" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Fonte}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{StaticResource Marca}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource MarcaEscura}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao "Fechar": pilula com contorno vermelho, igual a do app -->
        <Style x:Key="BotaoFechar" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Fonte}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Vermelho}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="20"
                                BorderBrush="{StaticResource VermelhoBorda}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="{StaticResource VermelhoClaro}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cabecalho de categoria: a linha inteira e clicavel, como no app -->
        <Style x:Key="BotaoCategoria" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="Transparent" Padding="20,16">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#06000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoQuantidade" TargetType="TextBox">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource Fonte}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="fundo" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#26000000" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Marca}"/>
                                <Setter TargetName="fundo" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
